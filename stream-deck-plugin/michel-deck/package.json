{
    "version": "0.2.1",
    "name": "michel-streamdeck-plugin",
    "description": "A streamdeck plugin with a few functionalities to control the MICHEL back API from a streamdeck",
    "author": "Martin 'Hoshin' Bahier",
    "license": "CC-BY-NC",
    "scripts": {
        "build": "rollup -c",
        "package:bash": "npx streamdeck pack -o ../../dist/streamdeck-plugin/ --version $npm_package_version.0 ./com.hoshin-casts.michel-deck.sdPlugin",
        "package:win": "npx streamdeck pack -o ../../dist/streamdeck-plugin/ --version %npm_package_version%.0 ./com.hoshin-casts.michel-deck.sdPlugin",
        "build-and-package:bash": "npm run build && npm run package:bash",
        "build-and-package:win": "npm run build && npm run package:win" ,
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.hoshin-casts.michel-deck\""
    },
    "type": "module",
    "devDependencies": {
        "@elgato/cli": "^1.1.1",
        "@rollup/plugin-commonjs": "^28.0.0",
        "@rollup/plugin-node-resolve": "^15.2.2",
        "@rollup/plugin-terser": "^0.4.4",
        "@rollup/plugin-typescript": "^12.1.0",
        "@tsconfig/node20": "^20.1.2",
        "@types/node": "~20.15.0",
        "rollup": "^4.0.2",
        "tslib": "^2.6.2",
        "typescript": "^5.2.2"
    },
    "dependencies": {
        "@elgato/streamdeck": "^1.0.0"
    }
}