# General build / dev artifacts
node_modules
.idea
.vscode
coverage
/dist/
*.log
*.xcf
/.ignore/

# back-specific
/back/config.json*

# front-specific
# User drop-in assets live here and must stay untracked, but the folder itself
# must exist (it is Vite's publicDir). Keep the directory via its .gitkeep.
/front/client-app/src/assets/custom/*
!/front/client-app/src/assets/custom/.gitkeep

# electron-specific
/electron-app/config.json

# streamdeck-specific
*.streamDeckPlugin
/stream-deck-plugin/**/*.js
/stream-deck-plugin/**/*.map
*.sdPlugin/bin
*.sdPlugin/logs