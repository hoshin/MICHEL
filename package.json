{
  "name": "michel-casting-tools",
  "version": "1.4.0",
  "description": "My tools to help me run a solo production when casting (tailored with the Overwatch game in mind)",
  "main": "electron-app/main.js",
  "type": "module",
  "author": {
    "name": "Martin 'Hoshin' Bahier",
    "email": "hoshin-casts@proton.me"
  },
  "license": "CC-BY-NC",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "tests": "npm run tests:electron-app",
    "tests:electron-app": "cd electron-app && npm run tests",
    "start:electron": "electron ./electron-app/main.js",
    "build:clean": "rimraf ./dist && rimraf release-builds",
    "build:back": "cd back && npm run build",
    "build:front": "cd front/client-app && npm run build",
    "build:streamdeck-plugin": "cd stream-deck-plugin/michel-deck && npm run build-and-package:win",
    "prebuild:electron-app:win": "node ./electron-app/scripts/kill-running-app.cjs",
    "prebuild:electron-app:linux": "node ./electron-app/scripts/kill-running-app.cjs",
    "prebuild:electron-app:mac": "node ./electron-app/scripts/kill-running-app.cjs",
    "build:electron-app": "npx electron-builder",
    "build:electron-app:win": "npx electron-builder --win --x64",
    "build:electron-app:linux": "npx electron-builder --linux --x64",
    "build:electron-app:mac": "npx electron-builder --mac --x64 --arm64",
    "build:all": "npm run build:clean && npm run build:back && npm run build:front && npm run build:streamdeck-plugin && npm run build:electron-app",
    "start": "npm run build:back && npm run build:front && concurrently \"npm run start:back:build\" \"npm run start:front\"",
    "start:back": "cd ./back && npm run start",
    "start:back:build": "node ./dist/back/index.js",
    "start:front": "cd ./front/client-app && npm run dev",
    "release:start": "node ./scripts/release-start.cjs",
    "release:finish": "node ./scripts/release-finish.cjs",
    "prepare": "husky"
  },
  "build": {
    "appId": "com.hoshin-casts-michelectron",
    "productName": "MICHELectron",
    "directories": {
      "output": "dist/electron-release-build"
    },
    "files": [
      "dist/back/**/*",
      "dist/front/**/*",
      "electron-app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron-app/images/logo_56.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "AudioVideo",
      "icon": "electron-app/images/logo_56.png"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "electron-app/images/logo_56.png",
      "identity": null
    }
  },
  "private": true,
  "dependencies": {
    "@elgato/cli": "^1.1.1",
    "antd": "^6.2.0",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "typescript": "^5.9.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.3",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
  }
}
