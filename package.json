{
  "name": "michel-casting-tools",
  "version": "1.0.0",
  "description": "My tools to help me run a solo production when casting (tailored with the Overwatch game in mind)",
  "main": "electron-app/main.js",
  "type": "module",
  "author": "Martin 'Hoshin' Bahier",
  "license": "CC-BY-NC",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:electron": "electron ./electron-app/main.js",
    "build:clean": "rimraf ./dist && rimraf release-builds",
    "build:back": "cd back && npm run build",
    "build:front": "cd front/client-app && npm run build",
    "build:streamdeck-plugin": "cd stream-deck-plugin/michel-deck && npm run build-and-package:win",
    "build:electron-app": "npx electron-builder",
    "build:all": "npm run build:clean && npm run build:back && npm run build:front && npm run build:streamdeck-plugin && npm run build:electron-app",
    "start:back": "cd ./back && npm run start",
    "start:back:build": "node ./dist/back/index.js",
    "start:front": "cd ./front/client-app && npm run dev"
  },
  "build": {
    "appId": "com.hoshin-casts-michelectron",
    "productName": "MICHELectron",
    "directories": {
      "output": "dist/electron-release-build"
    },
    "files": [
      "dist/back/**/*",
      "dist/front/**/*",
      "electron-app/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "private": true,
  "dependencies": {
    "@elgato/cli": "^1.1.1",
    "antd": "^6.2.0",
    "express": "^5.1.0",
    "typescript": "^5.9.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "electron": "^36.9.5",
    "electron-builder": "^26.0.12",
    "jest": "^30.1.3",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2"
  }
}
